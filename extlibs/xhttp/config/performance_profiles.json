{
	"schema": 1,
	"manifest": "extlibs/xhttp/config/modules.json",
	"defaults": {
		"repeats": 5,
		"warmups": 1,
		"timeout_seconds": 120,
		"policy": "baseline-unpinned",
		"cflags": [
			"-O2"
		],
		"ldflags": [],
		"max_relative_mad": 0.2,
		"max_relative_central_range": 0.3,
		"regression": {
			"higher": 0.1,
			"lower": 0.2
		}
	},
	"profiles": [
		{
			"name": "http_extension",
			"system": "http_extension",
			"description": "URL 解析与 Query 扫描无分配热路径",
			"benchmarks": [
				{
					"name": "http_extension",
					"source": "extlibs/xhttp/bench/bench_http_extension.c",
					"suite": "url,query_codec",
					"args": [
						"1000000"
					],
					"smoke_args": [
						"1000"
					],
					"metrics": {
						"url_parse_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						},
						"query_scan_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						}
					}
				}
			]
		}
	]
}
