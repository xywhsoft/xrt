{
	"schema": 1,
	"manifest": "extlibs/xhttp-server/config/modules.json",
	"defaults": {
		"repeats": 5,
		"warmups": 1,
		"timeout_seconds": 120,
		"policy": "baseline-unpinned",
		"cflags": [
			"-O2"
		],
		"ldflags": [],
		"max_relative_mad": 0.2,
		"max_relative_central_range": 0.3,
		"regression": {
			"higher": 0.1,
			"lower": 0.2
		}
	},
	"profiles": [
		{
			"name": "xhttp_server",
			"system": "xhttp_server",
			"description": "HTTP 服务器 热路径",
			"benchmarks": [
				{
					"name": "http_route",
					"source": "extlibs/xhttp-server/bench/bench_http_route.c",
					"suite": "http_route",
					"args": [
						"1000000"
					],
					"smoke_args": [
						"1000"
					],
					"metrics": {
						"route_match_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						}
					}
				}
			]
		}
	]
}
