{
	"schema": 1,
	"manifest": "extlibs/xhttp-server/config/modules.json",
	"defaults": {
		"repeats": 5,
		"warmups": 1,
		"timeout_seconds": 120,
		"policy": "baseline-unpinned",
		"cflags": [
			"-O2"
		],
		"ldflags": [],
		"max_relative_mad": 0.2,
		"max_relative_central_range": 0.3,
		"regression": {
			"higher": 0.1,
			"lower": 0.2
		}
	},
	"profiles": [
		{
			"name": "http_loopback",
			"system": "xhttp_server",
			"description": "HTTP/1.1 结构化响应与预构建原始响应的持久连接回环路径",
			"benchmarks": [
				{
					"name": "http_loopback",
					"source": "extlibs/xhttp-server/bench/bench_http_loopback.c",
					"suite": "http_client_easy_future,http_client_pool,http_server,http_server_raw",
					"args": [
						"5000"
					],
					"smoke_args": [
						"50"
					],
					"metrics": {
						"http_reply_requests_per_sec": {
							"direction": "higher",
							"unit": "requests/s"
						},
						"http_reply_latency_p99_us": {
							"direction": "lower",
							"unit": "microseconds"
						},
						"http_raw_requests_per_sec": {
							"direction": "higher",
							"unit": "requests/s"
						},
						"http_raw_latency_p99_us": {
							"direction": "lower",
							"unit": "microseconds"
						}
					}
				}
			]
		}
	]
}
