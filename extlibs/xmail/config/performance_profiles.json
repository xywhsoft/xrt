{
	"schema": 1,
	"manifest": "extlibs/xmail/config/modules.json",
	"defaults": {
		"repeats": 5,
		"warmups": 1,
		"timeout_seconds": 120,
		"policy": "baseline-unpinned",
		"cflags": [
			"-O2"
		],
		"ldflags": [],
		"max_relative_mad": 0.2,
		"max_relative_central_range": 0.3,
		"regression": {
			"higher": 0.1,
			"lower": 0.2
		}
	},
	"profiles": [
		{
			"name": "mail_content",
			"system": "mail_content",
			"description": "邮件编码、解码和字段游标热路径",
			"benchmarks": [
				{
					"name": "mail_content",
					"source": "extlibs/xmail/bench/bench_mail_content.c",
					"suite": "xmail",
					"args": [
						"100000"
					],
					"smoke_args": [
						"100"
					],
					"metrics": {
						"qp_mib_per_sec": {
							"direction": "higher",
							"unit": "MiB/s"
						},
						"base64_mib_per_sec": {
							"direction": "higher",
							"unit": "MiB/s"
						},
						"header_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						},
						"word_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						},
						"address_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						},
						"param_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						},
						"multipart_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						},
						"message_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						},
						"tree_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						},
						"builder_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						},
						"compose_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						}
					}
				}
			]
		},
		{
			"name": "mail_transport",
			"system": "mail_transport",
			"description": "邮件线路读写与 dot 编码零分配热路径",
			"benchmarks": [
				{
					"name": "mail_wire",
					"suite": "mail_wire",
					"source": "extlibs/xmail/bench/bench_mail_wire.c",
					"args": [
						"200000"
					],
					"smoke_args": [
						"100"
					],
					"metrics": {
						"wire_mib_per_sec": {
							"direction": "higher",
							"unit": "MiB/s"
						}
					}
				}
			]
		}
	]
}
