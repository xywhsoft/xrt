{
  "schema": 1,
  "manifest": "extlibs/xrpc/config/modules.json",
  "defaults": {
    "repeats": 5,
    "warmups": 1,
    "timeout_seconds": 120,
    "policy": "baseline-unpinned",
    "cflags": [
      "-O2"
    ],
    "ldflags": [],
    "max_relative_mad": 0.03,
    "max_relative_central_range": 0.06,
    "regression": {
      "higher": 0.05,
      "lower": 0.1
    }
  },
  "profiles": [
    {
      "name": "xrpc_decode",
      "system": "decode",
      "description": "Bounded JSON-RPC 2.0 descriptor decoding; no transports or production parity claim",
      "benchmarks": [
        {
          "name": "xrpc_decode",
          "source": "extlibs/xrpc/bench/bench_decode.c",
          "suite": "xrpc_decode,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "messages_per_sec": {
              "direction": "higher",
              "unit": "messages/s"
            }
          }
        }
      ]
    },
    {
      "name": "xrpc_encode",
      "system": "encode",
      "description": "Validated atomic JSON-RPC encoding into caller storage; no transports or production parity claim",
      "benchmarks": [
        {
          "name": "xrpc_encode",
          "source": "extlibs/xrpc/bench/bench_encode.c",
          "suite": "xrpc_encode,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "messages_per_sec": {
              "direction": "higher",
              "unit": "messages/s"
            }
          }
        }
      ]
    },
    {
      "name": "xrpc_dispatch",
      "system": "dispatch",
      "description": "Synchronous mixed batch decode/dispatch/reply preflight/single-object encoding; no transport or name index",
      "benchmarks": [
        {
          "name": "xrpc_dispatch",
          "source": "extlibs/xrpc/bench/bench_dispatch.c",
          "suite": "xrpc_dispatch,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "documents_per_sec": {
              "direction": "higher",
              "unit": "documents/s"
            },
            "messages_per_sec": {
              "direction": "higher",
              "unit": "messages/s"
            }
          },
          "facts": [
            "workload"
          ]
        }
      ]
    },
    {
      "name": "xrpc_methods",
      "system": "methods",
      "description": "Validated immutable method lookup and synchronous indexed dispatch; 4096 registrations, no transport acceptance",
      "benchmarks": [
        {
          "name": "xrpc_methods_plain",
          "source": "extlibs/xrpc/bench/bench_methods.c",
          "suite": "xrpc_methods,time",
          "args": [
            "1000000",
            "0"
          ],
          "smoke_args": [
            "10000",
            "0"
          ],
          "facts": [
            "workload",
            "mode",
            "index_methods",
            "requested_owned_bytes"
          ],
          "metrics": {
            "operations_per_sec": {
              "direction": "higher",
              "unit": "operations/s"
            },
            "operation_p50_us": {
              "direction": "lower",
              "unit": "us"
            },
            "operation_p99_us": {
              "direction": "lower",
              "unit": "us"
            },
            "completed": {
              "direction": "higher",
              "unit": "operations"
            },
            "latency_samples": {
              "direction": "higher",
              "unit": "samples"
            }
          }
        },
        {
          "name": "xrpc_methods_escaped",
          "source": "extlibs/xrpc/bench/bench_methods.c",
          "suite": "xrpc_methods,time",
