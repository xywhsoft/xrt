{
  "schema": 1,
  "manifest": "extlibs/xrpc/config/modules.json",
  "defaults": {
    "repeats": 5,
    "warmups": 1,
    "timeout_seconds": 120,
    "policy": "baseline-unpinned",
    "cflags": [
      "-O2"
    ],
    "ldflags": [],
    "max_relative_mad": 0.03,
    "max_relative_central_range": 0.06,
    "regression": {
      "higher": 0.05,
      "lower": 0.1
    }
  },
  "profiles": [
    {
      "name": "xrpc_decode",
      "system": "decode",
      "description": "Bounded JSON-RPC 2.0 descriptor decoding; no transports or production parity claim",
      "benchmarks": [
        {
          "name": "xrpc_decode",
          "source": "extlibs/xrpc/bench/bench_decode.c",
          "suite": "xrpc_decode,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "messages_per_sec": {
              "direction": "higher",
              "unit": "messages/s"
            }
          }
        }
      ]
    }
  ]
}
