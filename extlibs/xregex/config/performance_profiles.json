{
	"schema": 1,
	"manifest": "extlibs/xregex/config/modules.json",
	"defaults": {
		"repeats": 5,
		"warmups": 1,
		"timeout_seconds": 120,
		"policy": "baseline-unpinned",
		"cflags": ["-O2"],
		"ldflags": [],
		"max_relative_mad": 0.20,
		"max_relative_central_range": 0.30,
		"regression": {
			"higher": 0.10,
			"lower": 0.20
		}
	},
	"profiles": [
		{
			"name": "regex",
			"system": "regex",
			"description": "正则编译、matcher 复用、集合分类和替换写出热路径",
			"benchmarks": [
				{
					"name": "regex",
					"source": "extlibs/xregex/bench/bench_regex.c",
					"suite": "xregex",
					"args": ["100000"],
					"smoke_args": ["100"],
					"metrics": {
						"compile_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						},
						"match_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						},
						"set_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						},
						"replace_ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						}
					}
				}
			]
		}
	]
}
