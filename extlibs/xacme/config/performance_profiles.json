{
 "schema": 1,
 "manifest": "extlibs/xacme/config/modules.json",
 "defaults": {
  "repeats": 5,
  "warmups": 1,
  "timeout_seconds": 120,
  "policy": "baseline-unpinned",
  "cflags": [
   "-O2"
  ],
  "ldflags": [],
  "max_relative_mad": 0.2,
  "max_relative_central_range": 0.3,
  "regression": {
   "higher": 0.1,
   "lower": 0.2
  }
 },
 "profiles": [
  {
   "name": "acme_jose",
   "system": "acme_extension",
   "description": "ES256 JWS 组装热路径（确定性密钥，无网络）",
   "benchmarks": [
    {
     "name": "acme_jose",
     "suite": "acme_jose",
     "source": "extlibs/xacme/bench/bench_acme_jose.c",
     "args": [
      "5000"
     ],
     "smoke_args": [
      "50"
     ],
     "metrics": {
      "acme_jws_per_sec": {
       "direction": "higher",
       "unit": "operations/s"
      }
     }
    }
   ]
  }
 ]
}
