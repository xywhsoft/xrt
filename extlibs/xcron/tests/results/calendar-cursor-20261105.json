{
  "schema": 1,
  "stage": "allocation-free resumable UTC and civil single-result calendar cursors with constant impossible-day proof",
  "base_revision": "5675a16c09099c2da5870faebfa126014a7d5297",
  "feature_baseline_revision": "d3cb93186a501472c588cf051de4f5780c814459",
