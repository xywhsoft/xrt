      "source": "#include <xcron.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <inttypes.h>\nint main(int argc,char** argv)\n{\n    uint32 Budget=argc>1?(uint32)strtoul(argv[1],NULL,10):0;\n    uint64 N=1000000,Sum=0,Calls=0;\n    const cstr Text[]={\"* * * * * *\",\"0 */15 9-17 * * MON-FRI\",\"0 0 0 29 FEB *\",\"0 0 0 30 FEB *\",\"0 0 0 29 FEB */7\"};\n    xcronexpression E[5];xtime Begin,End,Finite;\n    for(unsigned I=0;I<5;++I)\n        if(!xcronExpressionCompile((xstrview){Text[I],strlen(Text[I])},XCRON_SECONDS6,&E[I],NULL))return 1;\n    if(!xrtDateTime(2024,3,1,9,0,0,123,&Begin) || !xrtDate(2425,1,1,&End) || !xrtDateTime(2031,12,31,23,59,59,999,&Finite))return 2;\n    double Start=xrtTimer();\n    for(uint64 I=0;I<N;++I){\n        unsigned Case=(unsigned)(I%5);xtime Next=0; xcroncalendarissue Issue;xcroncalendarstatus Status;\n        if(!Budget){Status=xcronCalendarNext(&E[Case],Begin+(xtime)(I%1000),Case==4?Finite:End,0,&Next,&Issue);++Calls;}\n        else{\n            xcroncalendarcursor C;\n            if(!xcronCalendarCursorInit(&C,&E[Case],Begin+(xtime)(I%1000),Case==4?Finite:End,0,&Issue))return 3;\n            do{Status=xcronCalendarCursorStep(&C,Budget,&Next,&Issue);++Calls;}while(Status==XCRON_CALENDAR_PENDING);\n        }\n        if(Status!=(Case>=3?XCRON_CALENDAR_NONE:XCRON_CALENDAR_FOUND))return 4;\n        Sum+=(uint64)Next+Issue.MonthsExamined;\n    }\n    printf(\"searches_per_sec: %.3f\\ncalls_per_search: %.3f\\nchecksum: %\" PRIu64 \"\\n\",N/(xrtTimer()-Start),(double)Calls/N,Sum);return 0;\n}\n",
