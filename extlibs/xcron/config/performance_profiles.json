          ],
          "facts": [
            "affinity",
            "drive",
            "active_jobs",
            "dormant_jobs",
            "waves",
            "verified_callbacks"
          ],
          "observations": [
            "wait_seconds",
            "first_lateness_p50_ms",
            "first_lateness_p95_ms",
            "first_lateness_p999_ms",
            "last_lateness_p50_ms",
