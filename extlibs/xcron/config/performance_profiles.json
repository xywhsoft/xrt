{
  "schema": 1,
  "manifest": "extlibs/xcron/config/modules.json",
  "defaults": {
    "repeats": 5,
    "warmups": 1,
    "timeout_seconds": 120,
    "policy": "baseline-unpinned",
    "cflags": [
      "-O2"
    ],
    "ldflags": [],
    "max_relative_mad": 0.03,
    "max_relative_central_range": 0.06,
    "regression": {
      "higher": 0.05,
      "lower": 0.1
    }
  },
  "profiles": [
    {
      "name": "xcron_expression",
      "system": "expression",
      "description": "Bounded caller-value expression compilation; no calendar, timezone or scheduler acceptance claim",
      "benchmarks": [
        {
          "name": "xcron_expression",
          "source": "extlibs/xcron/bench/bench_expression.c",
          "suite": "xcron_expression,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "expressions_per_sec": {
              "direction": "higher",
              "unit": "expressions/s"
            }
          }
        }
      ]
    },
    {
      "name": "xcron_calendar",
      "system": "calendar",
      "description": "Precompiled UTC dense/sparse/impossible Gregorian search with bounded complete cycle; no timezone/scheduler/latency acceptance",
      "benchmarks": [
        {
          "name": "xcron_calendar",
          "source": "extlibs/xcron/bench/bench_calendar.c",
          "suite": "xcron_calendar",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "searches_per_sec": {
              "direction": "higher",
              "unit": "searches/s"
            }
          }
        }
      ]
    },
    {
      "name": "xcron_scheduler",
      "system": "scheduler",
      "description": "Single UTC callback per second. Scheduler compared with direct XRT EventWaiter and fixed one-second recurrence.",
      "benchmarks": [
        {
          "name": "xcron_scheduler",
          "source": "extlibs/xcron/bench/bench_scheduler.c",
          "inputs": ["dev/bench/bench_common.h"],
          "suite": "xcron_scheduler,thread",
          "args": [
            "16"
          ],
          "smoke_args": [
            "4"
          ],
          "metrics": {
            "idle_polls_per_sec": {
              "direction": "higher",
              "unit": "polls/s"
            },
            "wait_cpu_percent": {
              "direction": "lower",
              "unit": "percent"
            },
            "wake_lateness_p99_ms": {
              "direction": "lower",
              "unit": "ms"
            },
            "wake_lateness_p50_ms": {
              "direction": "lower",
              "unit": "ms"
            },
            "wake_lateness_p95_ms": {
              "direction": "lower",
              "unit": "ms"
            }
          }
        },
        {
          "name": "xcron_xrt_waiter",
          "source": "extlibs/xcron/bench/bench_scheduler.c",
          "inputs": ["dev/bench/bench_common.h"],
          "suite": "xcron_scheduler,thread",
          "args": [
            "16",
            "waiter"
          ],
          "smoke_args": [
            "4",
            "waiter"
          ],
          "metrics": {
            "idle_polls_per_sec": {
              "direction": "higher",
              "unit": "polls/s"
            },
            "wait_cpu_percent": {
              "direction": "lower",
              "unit": "percent"
            },
            "wake_lateness_p99_ms": {
              "direction": "lower",
              "unit": "ms"
            },
            "wake_lateness_p50_ms": {
              "direction": "lower",
              "unit": "ms"
            },
            "wake_lateness_p95_ms": {
              "direction": "lower",
              "unit": "ms"
            }
          }
        }
      ]
    },
    {
      "name": "xcron_scheduler_cohort",
      "system": "scheduler",
      "description": "Same-second live callback cohorts with exact order and deadline checks, compared against an APP-known cohort on XRT EventWaiter.",
      "benchmarks": [
        {
          "name": "xcron_cohort_64_wait",
          "source": "extlibs/xcron/bench/bench_scheduler.c",
          "inputs": [
            "dev/bench/bench_common.h"
          ],
          "suite": "xcron_scheduler,thread",
          "args": [
            "cohort",
            "8",
            "64",
            "960",
            "wait"
          ],
          "smoke_args": [
            "cohort",
            "2",
            "64",
            "960",
            "wait"
          ],
          "facts": [
            "affinity",
            "drive",
            "active_jobs",
            "dormant_jobs",
            "waves",
            "verified_callbacks"
          ],
          "observations": [
            "wait_seconds",
            "first_lateness_p50_ms",
            "first_lateness_p95_ms",
            "first_lateness_p999_ms",
            "last_lateness_p50_ms",
            "last_lateness_p95_ms",
            "last_lateness_p999_ms",
            "callback_span_p50_us",
            "callback_span_p95_us",
            "callback_span_p999_us"
          ],
          "metrics": {
            "cpu_ns_per_callback": {
              "direction": "lower",
              "unit": "ns/callback"
            },
            "first_lateness_p99_ms": {
              "direction": "lower",
              "unit": "ms"
            },
            "last_lateness_p99_ms": {
              "direction": "lower",
              "unit": "ms"
            },
            "callback_span_p99_us": {
              "direction": "lower",
              "unit": "us"
            }
          }
        },
        {
          "name": "xcron_cohort_64_waiter",
          "source": "extlibs/xcron/bench/bench_scheduler.c",
          "inputs": [
            "dev/bench/bench_common.h"
          ],
          "suite": "xcron_scheduler,thread",
          "args": [
            "cohort",
            "8",
            "64",
            "960",
            "waiter"
          ],
          "smoke_args": [
            "cohort",
            "2",
            "64",
            "960",
            "waiter"
          ],
          "facts": [
            "affinity",
            "drive",
            "active_jobs",
            "dormant_jobs",
            "waves",
            "verified_callbacks"
          ],
          "observations": [
            "wait_seconds",
            "first_lateness_p50_ms",
            "first_lateness_p95_ms",
            "first_lateness_p999_ms",
            "last_lateness_p50_ms",
            "last_lateness_p95_ms",
            "last_lateness_p999_ms",
            "callback_span_p50_us",
            "callback_span_p95_us",
            "callback_span_p999_us"
          ],
          "metrics": {
            "cpu_ns_per_callback": {
              "direction": "lower",
              "unit": "ns/callback"
            },
            "first_lateness_p99_ms": {
              "direction": "lower",
              "unit": "ms"
            },
            "last_lateness_p99_ms": {
              "direction": "lower",
              "unit": "ms"
            },
            "callback_span_p99_us": {
              "direction": "lower",
              "unit": "us"
            }
          }
        },
        {
          "name": "xcron_cohort_1024_wait",
          "source": "extlibs/xcron/bench/bench_scheduler.c",
          "inputs": [
            "dev/bench/bench_common.h"
          ],
          "suite": "xcron_scheduler,thread",
          "args": [
            "cohort",
            "8",
            "1024",
            "0",
            "wait"
          ],
          "smoke_args": [
            "cohort",
            "2",
            "1024",
            "0",
            "wait"
          ],
          "facts": [
            "affinity",
            "drive",
            "active_jobs",
            "dormant_jobs",
            "waves",
            "verified_callbacks"
          ],
          "observations": [
            "wait_seconds",
            "first_lateness_p50_ms",
            "first_lateness_p95_ms",
            "first_lateness_p999_ms",
            "last_lateness_p50_ms",
            "last_lateness_p95_ms",
            "last_lateness_p999_ms",
            "callback_span_p50_us",
            "callback_span_p95_us",
            "callback_span_p999_us"
          ],
          "metrics": {
            "cpu_ns_per_callback": {
              "direction": "lower",
              "unit": "ns/callback"
            },
            "first_lateness_p99_ms": {
              "direction": "lower",
