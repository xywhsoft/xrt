{
  "schema": 1,
  "manifest": "extlibs/xcron/config/modules.json",
  "default_growth": {
    "text": 0.1,
    "data": 0.2,
    "bss": 0.2,
    "file": 0.15
  },
  "profiles": [
    {
      "name": "xcron_expression",
      "system": "expression",
      "suite": "xcron_expression",
      "description": "Only expression compilation and required core closure"
    },
    {
      "name": "xcron_calendar",
      "system": "calendar",
      "suite": "xcron_calendar",
      "description": "Gregorian UTC/civil search, expression and public XRT time/core; no local-zone or text parser",
      "forbid_symbols": [
        "xrtTimeLocal",
        "xrtTimeFromLocal",
        "xrtTimeWrite",
        "xrtTimeParse",
        "xrtDateTimeWrite",
        "xrtDateTimeParse",
        "_xrtTimeLocal",
        "_xrtTimeFromLocal",
        "_xrtTimeWrite",
        "_xrtTimeParse",
        "_xrtDateTimeWrite",
        "_xrtDateTimeParse"
      ]
    },
    {
      "name": "xcron_timezone",
      "system": "timezone",
      "suite": "xcron_timezone",
      "description": "Explicit rule core and time/atomic closure; no ambient local timezone, calendar, network or scheduler",
      "forbid_symbols": [
        "xrtTimeLocal",
        "xrtTimeFromLocal",
        "xcronCalendarNext",
        "xcronExpressionCompile",
        "_xrtTimeLocal",
        "_xrtTimeFromLocal",
        "_xcronCalendarNext",
        "_xcronExpressionCompile"
      ]
    },
    {
      "name": "xcron_zoned",
      "system": "zoned",
      "suite": "xcron_zoned",
      "description": "Actual-instant zoned Gregorian search with explicit rule/history dependencies; no host TZ/network/wait/scheduler",
      "forbid_symbols": [
        "xrtTimeLocal",
        "xrtTimeFromLocal",
        "xrtNetEngineCreate",
        "xrtThreadCreate",
        "_xrtTimeLocal",
        "_xrtTimeFromLocal",
        "_xrtNetEngineCreate",
        "_xrtThreadCreate"
      ]
    }
  ]
}
