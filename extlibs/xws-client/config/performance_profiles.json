{
	"schema": 1,
	"manifest": "extlibs/xws-client/config/modules.json",
	"defaults": {
		"repeats": 5,
		"warmups": 1,
		"timeout_seconds": 120,
		"policy": "baseline-unpinned",
		"cflags": [
			"-O2"
		],
		"ldflags": [],
		"max_relative_mad": 0.2,
		"max_relative_central_range": 0.3,
		"regression": {
			"higher": 0.1,
			"lower": 0.2
		}
	},
	"profiles": [
		{
			"name": "client_request",
			"system": "websocket_extension",
			"description": "xws-client client_request",
			"benchmarks": [
				{
					"name": "client_request",
					"source": "extlibs/xws-client/bench/bench_client_request.c",
					"suite": "websocket_client",
					"args": [
						"10000"
					],
					"smoke_args": [
						"50"
					],
					"metrics": {
						"client_request_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						}
					}
				}
			]
		}
	]
}
