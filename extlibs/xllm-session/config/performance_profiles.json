{
	"schema": 1,
	"manifest": "extlibs/xllm-session/config/modules.json",
	"defaults": {
		"repeats": 5,
		"warmups": 1,
		"timeout_seconds": 120,
		"policy": "baseline-unpinned",
		"cflags": [
			"-O2"
		],
		"ldflags": [],
		"max_relative_mad": 0.2,
		"max_relative_central_range": 0.3,
		"regression": {
			"higher": 0.1,
			"lower": 0.2
		}
	},
	"profiles": [
		{
			"name": "xllm_session",
			"system": "session",
			"description": "xllm-session public operation",
			"benchmarks": [
				{
					"name": "xllm_session",
					"source": "extlibs/xllm-session/bench/bench_xllm_session.c",
					"suite": "xllm_session",
					"args": [
						"10000"
					],
					"smoke_args": [
						"100"
					],
					"metrics": {
						"ops_per_sec": {
							"direction": "higher",
							"unit": "operations/s"
						}
					}
				}
			]
		}
	]
}
