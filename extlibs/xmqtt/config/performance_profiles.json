{
  "schema": 1,
  "manifest": "extlibs/xmqtt/config/modules.json",
  "defaults": {
    "repeats": 5,
    "warmups": 1,
    "timeout_seconds": 120,
    "policy": "baseline-unpinned",
    "cflags": [
      "-O2"
    ],
    "ldflags": [],
    "max_relative_mad": 0.03,
    "max_relative_central_range": 0.06,
    "regression": {
      "higher": 0.05,
      "lower": 0.1
    }
  },
  "profiles": [
    {
      "name": "xmqtt_wire",
      "system": "wire",
      "description": "Bounded framing, UTF-8 topic field and fixed-header writing; no packet/session completeness or production parity claim",
      "benchmarks": [
        {
          "name": "xmqtt_wire",
          "source": "extlibs/xmqtt/bench/bench_wire.c",
          "suite": "xmqtt_wire,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "frames_per_sec": {
              "direction": "higher",
              "unit": "frames/s"
            }
          }
        }
      ]
    },
    {
      "name": "xmqtt_properties",
      "system": "properties",
      "description": "MQTT 5 property-section decode/encode into caller storage; no packet/client or performance parity claim",
      "benchmarks": [
        {
          "name": "xmqtt_properties",
          "source": "extlibs/xmqtt/bench/bench_properties.c",
          "suite": "xmqtt_properties,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "sections_per_sec": {
              "direction": "higher",
              "unit": "sections/s"
            }
          }
        }
      ]
    },
    {
      "name": "xmqtt_packet",
      "system": "packet",
      "description": "Private already-UTF8-validated ASCII filter grammar only; no subscription or codec throughput claim",
      "benchmarks": [
        {
          "name": "xmqtt_packet",
          "source": "extlibs/xmqtt/bench/bench_packet.c",
          "suite": "xmqtt_packet,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "filters_per_sec": {
              "direction": "higher",
              "unit": "filters/s"
            }
          }
        }
      ]
    },
    {
      "name": "xmqtt_codec5",
      "system": "codec5",
      "description": "Full MQTT5 QoS1 PUBLISH property/PFI decode and atomic encode in caller storage; no network/session/queueing/durability parity claim",
      "benchmarks": [
        {
          "name": "xmqtt_codec5",
          "source": "extlibs/xmqtt/bench/bench_codec5.c",
          "suite": "xmqtt_codec5,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "packets_per_sec": {
              "direction": "higher",
              "unit": "packets/s"
            }
          }
        }
      ]
    },
    {
      "name": "xmqtt_codec311",
      "system": "codec311",
      "description": "Full MQTT311 binary QoS1 PUBLISH decode/atomic encode in caller storage; no network/session or cross-protocol performance claim",
      "benchmarks": [
        {
          "name": "xmqtt_codec311",
          "source": "extlibs/xmqtt/bench/bench_codec311.c",
          "suite": "xmqtt_codec311,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "packets_per_sec": {
              "direction": "higher",
              "unit": "packets/s"
            }
          }
        }
      ]
    },
    {
      "name": "xmqtt_negotiation",
      "system": "negotiation",
      "description": "Two validated handshake descriptors and one outbound packet check per cycle; dual version, no network/session/capacity/comparator claim",
      "benchmarks": [
        {
          "name": "xmqtt_negotiation_5",
          "source": "extlibs/xmqtt/bench/bench_negotiation.c",
          "suite": "xmqtt_negotiation,time",
          "args": [
            "1000000",
            "5"
          ],
          "smoke_args": [
            "10000",
            "5"
          ],
          "metrics": {
            "negotiation_cycles_per_sec": {
              "direction": "higher",
              "unit": "cycles/s"
            }
          }
        },
        {
          "name": "xmqtt_negotiation_4",
          "source": "extlibs/xmqtt/bench/bench_negotiation.c",
          "suite": "xmqtt_negotiation,time",
          "args": [
            "1000000",
            "4"
          ],
          "smoke_args": [
            "10000",
            "4"
          ],
          "metrics": {
            "negotiation_cycles_per_sec": {
              "direction": "higher",
              "unit": "cycles/s"
            }
          }
        }
      ]
    },
    {
      "name": "xmqtt_client_qos1",
      "system": "client",
      "description": "Single loopback connection to an in-process local fixture, closed-loop 32-inflight QoS1 application-observed PUBACK latency/throughput; separate heap-instrumented variants include client plus peer and first lazy id-table allocation. Excludes connect/close; not broker/comparator/production parity.",
      "benchmarks": [
        {
          "name": "xmqtt_qos1_5",
          "source": "extlibs/xmqtt/bench/bench_client_qos1.c",
          "suite": "xmqtt_client,time",
          "inputs": [
            "extlibs/xmqtt/examples/common/client_peer.h"
          ],
          "args": [
            "20000",
            "5",
            "32",
            "0"
          ],
          "smoke_args": [
            "128",
            "5",
            "8",
            "0"
          ],
          "metrics": {
            "publishes_per_sec": {
              "direction": "higher",
              "unit": "publish/s"
            },
            "latency_p50_us": {
              "direction": "lower",
              "unit": "us"
            },
            "latency_p99_us": {
              "direction": "lower",
              "unit": "us"
            },
            "latency_max_us": {
              "direction": "lower",
              "unit": "us"
            }
          }
        },
        {
          "name": "xmqtt_qos1_4",
          "source": "extlibs/xmqtt/bench/bench_client_qos1.c",
          "suite": "xmqtt_client,time",
          "inputs": [
            "extlibs/xmqtt/examples/common/client_peer.h"
          ],
          "args": [
            "20000",
            "4",
            "32",
            "0"
          ],
          "smoke_args": [
            "128",
            "4",
            "8",
            "0"
          ],
          "metrics": {
            "publishes_per_sec": {
              "direction": "higher",
              "unit": "publish/s"
            },
            "latency_p50_us": {
              "direction": "lower",
              "unit": "us"
            },
            "latency_p99_us": {
              "direction": "lower",
              "unit": "us"
            },
            "latency_max_us": {
              "direction": "lower",
              "unit": "us"
            }
          }
        },
        {
          "name": "xmqtt_qos1_5_alloc",
          "source": "extlibs/xmqtt/bench/bench_client_qos1.c",
          "suite": "xmqtt_client,time,memory_stats",
          "inputs": [
            "extlibs/xmqtt/examples/common/client_peer.h"
          ],
          "args": [
            "20000",
            "5",
            "32",
            "1"
          ],
          "smoke_args": [
            "128",
            "5",
            "8",
            "1"
          ],
          "metrics": {
            "publishes_per_sec": {
              "direction": "higher",
              "unit": "publish/s"
            },
            "latency_p50_us": {
              "direction": "lower",
              "unit": "us"
            },
            "latency_p99_us": {
              "direction": "lower",
              "unit": "us"
            },
            "latency_max_us": {
              "direction": "lower",
              "unit": "us"
            },
            "heap_blocks_per_publish": {
              "direction": "lower",
              "unit": "blocks/publish"
            },
            "heap_bytes_per_publish": {
              "direction": "lower",
              "unit": "bytes/publish"
            }
          }
        },
        {
          "name": "xmqtt_qos1_4_alloc",
          "source": "extlibs/xmqtt/bench/bench_client_qos1.c",
          "suite": "xmqtt_client,time,memory_stats",
          "inputs": [
            "extlibs/xmqtt/examples/common/client_peer.h"
          ],
          "args": [
            "20000",
            "4",
            "32",
            "1"
          ],
          "smoke_args": [
            "128",
            "4",
            "8",
            "1"
          ],
          "metrics": {
            "publishes_per_sec": {
              "direction": "higher",
              "unit": "publish/s"
            },
            "latency_p50_us": {
              "direction": "lower",
              "unit": "us"
            },
            "latency_p99_us": {
              "direction": "lower",
              "unit": "us"
            },
            "latency_max_us": {
              "direction": "lower",
              "unit": "us"
            },
            "heap_blocks_per_publish": {
              "direction": "lower",
              "unit": "blocks/publish"
            },
            "heap_bytes_per_publish": {
              "direction": "lower",
              "unit": "bytes/publish"
            }
          }
        }
      ]
    }
  ]
}
