{
  "schema": 1,
  "manifest": "extlibs/xmqtt/config/modules.json",
  "defaults": {
    "repeats": 5,
    "warmups": 1,
    "timeout_seconds": 120,
    "policy": "baseline-unpinned",
    "cflags": [
      "-O2"
    ],
    "ldflags": [],
    "max_relative_mad": 0.03,
    "max_relative_central_range": 0.06,
    "regression": {
      "higher": 0.05,
      "lower": 0.1
    }
  },
  "profiles": [
    {
      "name": "xmqtt_wire",
      "system": "wire",
      "description": "Bounded framing, UTF-8 topic field and fixed-header writing; no packet/session completeness or production parity claim",
      "benchmarks": [
        {
          "name": "xmqtt_wire",
          "source": "extlibs/xmqtt/bench/bench_wire.c",
          "suite": "xmqtt_wire,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "frames_per_sec": {
              "direction": "higher",
              "unit": "frames/s"
            }
          }
        }
      ]
    },
    {
      "name": "xmqtt_properties",
      "system": "properties",
      "description": "MQTT 5 property-section decode/encode into caller storage; no packet/client or performance parity claim",
      "benchmarks": [
        {
          "name": "xmqtt_properties",
          "source": "extlibs/xmqtt/bench/bench_properties.c",
          "suite": "xmqtt_properties,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "sections_per_sec": {
              "direction": "higher",
              "unit": "sections/s"
            }
          }
        }
      ]
    },
    {
      "name": "xmqtt_packet",
      "system": "packet",
      "description": "Private already-UTF8-validated ASCII filter grammar only; no subscription or codec throughput claim",
      "benchmarks": [
        {
          "name": "xmqtt_packet",
          "source": "extlibs/xmqtt/bench/bench_packet.c",
          "suite": "xmqtt_packet,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "filters_per_sec": {
              "direction": "higher",
              "unit": "filters/s"
            }
          }
        }
      ]
    },
    {
      "name": "xmqtt_codec5",
      "system": "codec5",
      "description": "Full MQTT5 QoS1 PUBLISH property/PFI decode and atomic encode in caller storage; no network/session/queueing/durability parity claim",
      "benchmarks": [
        {
          "name": "xmqtt_codec5",
          "source": "extlibs/xmqtt/bench/bench_codec5.c",
          "suite": "xmqtt_codec5,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "packets_per_sec": {
              "direction": "higher",
              "unit": "packets/s"
            }
          }
        }
      ]
    }
  ]
}
