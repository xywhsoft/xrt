  ],
  "feature": "xmqtt_reconnect_subscriptions",
  "defaults": {
    "max_filters": 1024,
    "max_bytes": 4194304,
    "max_batch": 32,
    "operation_timeout_ms": 30000,
    "retry_delay_ms": 5,
    "fail_on_rejected": true
  },
  "implementation_costs": [
    "one optional registry pointer in selected controller storage; one captured actual outgoing-byte cap per registry",
    "fixed entries/hash buckets/dirty queue/batch scratch; owned encoded input and decoded property/topic/order metadata",
    "two in-place heapsorts at intent admission; bounded hash lookup and aggregate counters; session transition scans the entry table",
    "one ordinary Client Future and one heap watch per accepted control; at most two allocated watch nodes; actual Root references cover callback tails",
    "candidate negotiated checks rescan a growing prefix within MaxBatch; actual Client outgoing capacity, including factory narrowing, also splits batches",
    "Client/Session/Inbox/native/allocator overhead are separate limits; partly superseded snapshots stay charged until last reference retires",
    "no additional per-publication callback, payload copy/scan, Future wrapper, lease operation or idle heartbeat"
  ],
  "behavior": [
    "copy all initial descriptors before asynchronous work; gate initial/recovery ONLINE on current intent reconciliation",
    "retain confirmed state on SessionPresent1; rebuild wanted filters/discard removal tombstones on SessionPresent0",
    "atomic latest desired snapshots with revision tokens; superseded ACKs cannot confirm newer intent",
    "preserve options and full MQTT5 group properties across subsets; correlate ordered per-filter results",
    "strict or explicit partial-rejection policy; full immutable ACK metadata callback may be retained beyond all owners",
    "offline additions/removals and uncertain controls; finite configured recovery/online/admission budgets; actual physical cleanup"
  ],
