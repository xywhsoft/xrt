{
  "schema": 1,
  "manifest": "extlibs/xredis/config/modules.json",
  "defaults": {
    "repeats": 5,
    "warmups": 1,
    "timeout_seconds": 120,
    "policy": "baseline-unpinned",
    "cflags": [
      "-O2"
    ],
    "ldflags": [],
    "max_relative_mad": 0.03,
    "max_relative_central_range": 0.06,
    "regression": {
      "higher": 0.05,
      "lower": 0.1
    }
  },
  "profiles": [
    {
      "name": "xredis_command",
      "system": "command",
      "description": "Caller-buffer binary RESP command encoding; no networking, reply decoding or external-client parity claim",
      "benchmarks": [
        {
          "name": "xredis_command",
          "source": "extlibs/xredis/bench/bench_command.c",
          "suite": "xredis_command,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "commands_per_sec": {
              "direction": "higher",
              "unit": "commands/s"
            },
            "wire_bytes_per_sec": {
              "direction": "higher",
              "unit": "bytes/s"
            }
          }
        }
      ]
    },
    {
      "name": "xredis_reader",
      "system": "reader",
      "description": "Bounded RESP2/3 streaming events; no owned reply builder, networking or external-client parity claim",
      "benchmarks": [
        {
          "name": "xredis_reader",
          "source": "extlibs/xredis/bench/bench_reader.c",
          "suite": "xredis_reader,time",
          "args": ["1000000"],
          "smoke_args": ["10000"],
          "metrics": {
            "frames_per_sec": {"direction": "higher", "unit": "frames/s"},
            "wire_bytes_per_sec": {"direction": "higher", "unit": "bytes/s"}
          }
        }
      ]
    },
    {
      "name": "xredis_reply",
      "system": "reply",
      "description": "Owned scalar/metadata/streamed replies including allocation, traversal, double conversion and release; no network/parity claim",
      "benchmarks": [{
        "name": "xredis_reply",
        "source": "extlibs/xredis/bench/bench_reply.c",
        "suite": "xredis_reply,time",
        "args": ["1000000"],
        "smoke_args": ["10000"],
        "metrics": {
          "frames_per_sec": {"direction": "higher", "unit": "frames/s"},
          "wire_bytes_per_sec": {"direction": "higher", "unit": "bytes/s"}
        }
      }]
    },
    {
      "name": "xredis_client",
      "system": "client",
      "description": "Closed-loop local TCP peer, 2 workers, pipeline 16; API-to-observation latency includes encoding/queueing but no open-loop or Redis/Hiredis parity claim",
      "benchmarks": [{
        "name": "xredis_client",
        "source": "extlibs/xredis/bench/bench_client.c",
        "inputs": ["extlibs/xredis/tests/support/client_peer.h"],
        "suite": "xredis_client",
        "args": ["100000", "16"],
        "smoke_args": ["1024", "16"],
        "metrics": {
          "requests_per_sec": {"direction": "higher", "unit": "requests/s"},
          "p50_us": {"direction": "lower", "unit": "us"},
          "p95_us": {"direction": "lower", "unit": "us"},
          "p99_us": {"direction": "lower", "unit": "us"},
          "p999_us": {"direction": "lower", "unit": "us"}
        }
      }]
    },
    {
      "name": "xredis_client_init",
      "system": "client",
      "description": "Serial cold HELLO3 AUTH plus SELECT against a local fixture; handshake includes encoding/worker/TCP/reply observation, lifecycle rate also includes peer/engine create/retire; not production throughput or parity",
      "benchmarks": [{
        "name": "xredis_client_init",
        "source": "extlibs/xredis/bench/bench_client_init.c",
        "inputs": ["extlibs/xredis/tests/support/client_peer.h", "extlibs/xredis/tests/support/client_init_peer.h"],
        "suite": "xredis_client",
        "args": ["256"],
        "smoke_args": ["16"],
        "metrics": {
          "lifecycle_per_sec": {"direction": "higher", "unit": "lifecycles/s"},
          "handshake_p50_us": {"direction": "lower", "unit": "us"},
          "handshake_p95_us": {"direction": "lower", "unit": "us"},
          "handshake_p99_us": {"direction": "lower", "unit": "us"},
          "handshake_p999_us": {"direction": "lower", "unit": "us"}
        }
      }]
    },
    {
      "name": "xredis_openloop",
      "system": "client",
      "description": "Fixed absolute arrivals with bounded observer slots; all planned offers retained, successful and all-outcome latency separate, generator lag and rejection/timeout visible; local fixture, unpinned",
      "benchmarks": [{
        "name": "xredis_openloop", "source": "extlibs/xredis/bench/bench_client_openloop.c",
        "inputs": ["extlibs/xredis/bench/openloop_run.h", "extlibs/xredis/bench/openloop_schedule.h", "extlibs/xredis/tests/support/client_peer.h"],
        "suite": "xredis_client",
        "args": ["100000", "100000", "256", "32", "1000"],
        "smoke_args": ["256", "5000", "64", "32", "1000"],
        "facts": ["arrival_model", "target", "network_backend", "memory_stats", "generator_mode", "workers", "slot_capacity", "payload_bytes", "max_inflight", "target_rate_per_sec", "intended_timeout_ms"],
        "metrics": {
          "success_requests_per_sec": {"direction": "higher", "unit": "requests/s"},
          "success_p50_us": {"direction": "lower", "unit": "us"},
          "success_p95_us": {"direction": "lower", "unit": "us"},
          "success_p99_us": {"direction": "lower", "unit": "us"},
          "success_p999_us": {"direction": "lower", "unit": "us"},
          "all_p99_us": {"direction": "lower", "unit": "us"},
          "all_p999_us": {"direction": "lower", "unit": "us"},
          "generator_p99_us": {"direction": "lower", "unit": "us"},
          "unsuccessful": {"direction": "lower", "unit": "offers"},
          "harness_capacity": {"direction": "lower", "unit": "offers"},
          "client_overloaded": {"direction": "lower", "unit": "offers"},
          "expired_before_admission": {"direction": "lower", "unit": "offers"},
          "request_timeout": {"direction": "lower", "unit": "requests"},
          "deadline_missed": {"direction": "lower", "unit": "offers"},
          "process_window_cpu_seconds": {"direction": "lower", "unit": "s"},
          "process_peak_rss_bytes": {"direction": "lower", "unit": "bytes"}
        }
      }]
    },
    {
      "name": "xredis_openloop_stats",
      "system": "client",
      "description": "Same fixed-arrival workload with XRT memory statistics enabled; whole-process window includes local peer and retirement, separate from uninstrumented latency",
      "benchmarks": [{
        "name": "xredis_openloop_stats", "source": "extlibs/xredis/bench/bench_client_openloop.c",
        "inputs": ["extlibs/xredis/bench/openloop_run.h", "extlibs/xredis/bench/openloop_schedule.h", "extlibs/xredis/tests/support/client_peer.h"],
        "suite": "xredis_client,memory_stats",
        "args": ["100000", "100000", "256", "32", "1000", "0", "0", "0", "1"],
        "smoke_args": ["256", "5000", "64", "32", "1000", "0", "0", "0", "1"],
        "facts": ["arrival_model", "target", "network_backend", "memory_stats", "generator_mode", "workers", "slot_capacity", "payload_bytes", "max_inflight", "target_rate_per_sec", "intended_timeout_ms"],
        "metrics": {
          "success_requests_per_sec": {"direction": "higher", "unit": "requests/s"},
          "success_p99_us": {"direction": "lower", "unit": "us"},
          "unsuccessful": {"direction": "lower", "unit": "offers"},
          "window_malloc_calls": {"direction": "lower", "unit": "calls"},
          "window_calloc_calls": {"direction": "lower", "unit": "calls"},
          "window_realloc_calls": {"direction": "lower", "unit": "calls"},
          "window_memdup_calls": {"direction": "lower", "unit": "calls"},
          "window_block_alloc_calls": {"direction": "lower", "unit": "calls"},
          "window_backing_alloc_calls": {"direction": "lower", "unit": "calls"},
          "window_backing_alloc_bytes": {"direction": "lower", "unit": "bytes"},
          "process_window_cpu_seconds": {"direction": "lower", "unit": "s"},
          "process_peak_rss_bytes": {"direction": "lower", "unit": "bytes"}
        }
      }]
    },
    {
      "name": "xredis_openloop_stall",
      "system": "client",
      "description": "Controlled initial generator stall; expired planned arrivals must remain in accounting, no client throughput acceptance",
      "benchmarks": [{
        "name": "xredis_openloop_stall", "source": "extlibs/xredis/bench/bench_client_openloop.c",
        "inputs": ["extlibs/xredis/bench/openloop_run.h", "extlibs/xredis/bench/openloop_schedule.h", "extlibs/xredis/tests/support/client_peer.h"],
        "suite": "xredis_client",
        "args": ["32", "1000000", "32", "32", "10", "1", "50"],
        "smoke_args": ["32", "1000000", "32", "32", "10", "1", "50"],
        "facts": ["arrival_model", "target", "network_backend", "memory_stats", "generator_mode", "workers", "slot_capacity", "payload_bytes", "max_inflight", "target_rate_per_sec", "intended_timeout_ms"],
        "metrics": {
          "offered": {"direction": "higher", "unit": "offers"},
          "expired_before_admission": {"direction": "higher", "unit": "offers"},
          "all_p99_us": {"direction": "lower", "unit": "us"},
          "generator_p99_us": {"direction": "lower", "unit": "us"}
        }
      }]
    },
    {
      "name": "xredis_openloop_hold",
      "system": "client",
      "description": "Controlled held ECHO replies force bounded observer-capacity rejection and request timeout; fault-path accounting, no throughput acceptance",
      "benchmarks": [{
        "name": "xredis_openloop_hold", "source": "extlibs/xredis/bench/bench_client_openloop.c",
        "inputs": ["extlibs/xredis/bench/openloop_run.h", "extlibs/xredis/bench/openloop_schedule.h", "extlibs/xredis/tests/support/client_peer.h"],
        "suite": "xredis_client",
        "args": ["4096", "1000000", "64", "32", "100", "2"],
        "smoke_args": ["64", "1000000", "8", "32", "100", "2"],
        "facts": ["arrival_model", "target", "network_backend", "memory_stats", "generator_mode", "workers", "slot_capacity", "payload_bytes", "max_inflight", "target_rate_per_sec", "intended_timeout_ms"],
        "metrics": {
          "offered": {"direction": "higher", "unit": "offers"},
          "harness_capacity": {"direction": "higher", "unit": "offers"},
          "request_timeout": {"direction": "higher", "unit": "requests"},
          "all_p99_us": {"direction": "lower", "unit": "us"}
        }
      }]
    },
