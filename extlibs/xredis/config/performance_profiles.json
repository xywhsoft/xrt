{
  "schema": 1,
  "manifest": "extlibs/xredis/config/modules.json",
  "defaults": {
    "repeats": 5,
    "warmups": 1,
    "timeout_seconds": 120,
    "policy": "baseline-unpinned",
    "cflags": [
      "-O2"
    ],
    "ldflags": [],
    "max_relative_mad": 0.03,
    "max_relative_central_range": 0.06,
    "regression": {
      "higher": 0.05,
      "lower": 0.1
    }
  },
  "profiles": [
    {
      "name": "xredis_command",
      "system": "command",
      "description": "Caller-buffer binary RESP command encoding; no networking, reply decoding or external-client parity claim",
      "benchmarks": [
        {
          "name": "xredis_command",
          "source": "extlibs/xredis/bench/bench_command.c",
          "suite": "xredis_command,time",
          "args": [
            "1000000"
          ],
          "smoke_args": [
            "10000"
          ],
          "metrics": {
            "commands_per_sec": {
              "direction": "higher",
              "unit": "commands/s"
            },
            "wire_bytes_per_sec": {
              "direction": "higher",
              "unit": "bytes/s"
            }
          }
        }
      ]
    },
    {
      "name": "xredis_reader",
      "system": "reader",
      "description": "Bounded RESP2/3 streaming events; no owned reply builder, networking or external-client parity claim",
      "benchmarks": [
        {
          "name": "xredis_reader",
          "source": "extlibs/xredis/bench/bench_reader.c",
          "suite": "xredis_reader,time",
          "args": ["1000000"],
          "smoke_args": ["10000"],
          "metrics": {
            "frames_per_sec": {"direction": "higher", "unit": "frames/s"},
            "wire_bytes_per_sec": {"direction": "higher", "unit": "bytes/s"}
          }
        }
      ]
    },
    {
      "name": "xredis_reply",
      "system": "reply",
      "description": "Owned scalar/metadata/streamed replies including allocation, traversal, double conversion and release; no network/parity claim",
      "benchmarks": [{
        "name": "xredis_reply",
        "source": "extlibs/xredis/bench/bench_reply.c",
        "suite": "xredis_reply,time",
        "args": ["1000000"],
        "smoke_args": ["10000"],
        "metrics": {
          "frames_per_sec": {"direction": "higher", "unit": "frames/s"},
          "wire_bytes_per_sec": {"direction": "higher", "unit": "bytes/s"}
        }
      }]
    },
    {
      "name": "xredis_client",
      "system": "client",
      "description": "Closed-loop local TCP peer, 2 workers, pipeline 16; API-to-observation latency includes encoding/queueing but no open-loop or Redis/Hiredis parity claim",
      "benchmarks": [{
        "name": "xredis_client",
        "source": "extlibs/xredis/bench/bench_client.c",
        "inputs": ["extlibs/xredis/tests/support/client_peer.h"],
        "suite": "xredis_client",
        "args": ["100000", "16"],
        "smoke_args": ["1024", "16"],
        "metrics": {
          "requests_per_sec": {"direction": "higher", "unit": "requests/s"},
          "p50_us": {"direction": "lower", "unit": "us"},
          "p95_us": {"direction": "lower", "unit": "us"},
          "p99_us": {"direction": "lower", "unit": "us"},
          "p999_us": {"direction": "lower", "unit": "us"}
        }
      }]
    },
    {
      "name": "xredis_client_init",
      "system": "client",
      "description": "Serial cold HELLO3 AUTH plus SELECT against a local fixture; handshake includes encoding/worker/TCP/reply observation, lifecycle rate also includes peer/engine create/retire; not production throughput or parity",
      "benchmarks": [{
        "name": "xredis_client_init",
        "source": "extlibs/xredis/bench/bench_client_init.c",
        "inputs": ["extlibs/xredis/tests/support/client_peer.h", "extlibs/xredis/tests/support/client_init_peer.h"],
        "suite": "xredis_client",
        "args": ["256"],
        "smoke_args": ["16"],
        "metrics": {
          "lifecycle_per_sec": {"direction": "higher", "unit": "lifecycles/s"},
          "handshake_p50_us": {"direction": "lower", "unit": "us"},
          "handshake_p95_us": {"direction": "lower", "unit": "us"},
          "handshake_p99_us": {"direction": "lower", "unit": "us"},
          "handshake_p999_us": {"direction": "lower", "unit": "us"}
        }
      }]
    }
  ]
}
