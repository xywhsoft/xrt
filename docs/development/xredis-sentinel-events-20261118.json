  "evidence_directory": "out/service-extensions/xredis-sentinel-events-20261118",
  "scope": "Optional native Sentinel Pub/Sub listener with bounded event consumption, reconnect and verified refresh.",
  "cases": [
    "RESP2 and RESP3 exact service filtering and malformed event rejection.",
    "Valid event payload provides no endpoint authority; role verification fences still-live old leases.",
    "Bounded receive batches and paced hint coalescing.",
    "Real Sentinel election generates native switch events, and both pool roles submit a verified refresh hint.",
    "Local transport loss restores subscription through a learned seed and catches up without receiving the missed message.",
    "Optional subscription denial or construction OOM preserves existing leases; close during ACK wait retires native context."
  ],
